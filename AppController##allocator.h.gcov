        -:  129:   *
        -:  130:   *  @headerfile memory
        -:  131:   */
        -:  132:  template<typename _Tp>
        -:  133:    class allocator : public __allocator_base<_Tp>
        -:  134:    {
        -:  135:    public:
        -:  136:      typedef _Tp        value_type;
        -:  137:      typedef size_t     size_type;
