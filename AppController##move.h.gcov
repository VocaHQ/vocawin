        -:  173:  template<typename _Tp>
        -:  174:    [[__nodiscard__,__gnu__::__always_inline__]]
        -:  175:    inline _GLIBCXX17_CONSTEXPR _Tp*
        -:  176:    addressof(_Tp& __r) noexcept
    #####:  177:    { return __builtin_addressof(__r); }
