        -:  243:  // _GLIBCXX_RESOLVE_LIB_DEFECTS
        -:  244:  // DR 809. std::swap should be overloaded for array types.
        -:  245:  /// Swap the contents of two arrays.
        -:  246:  template<typename _Tp, size_t _Nm>
