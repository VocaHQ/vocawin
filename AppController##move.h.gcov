        -:  223:    _GLIBCXX20_CONSTEXPR inline
        -:  224:    __enable_if_t<__and_<__not_<__is_tuple_like<_Tp>>,
        -:  225:			 is_move_constructible<_Tp>,
        -:  226:			 is_move_assignable<_Tp>>::value>
